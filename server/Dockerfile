# Визначаємо базовий образ Node.js
FROM node:18-alpine

# Створюємо робочу директорію всередині контейнера
WORKDIR /app

# Копіюємо файлів залежностей
COPY package*.json ./

# Встановлюємо залежності
RUN npm install

# Копіюємо весь решту коду сервера
COPY . .

# Відкриваємо порт, на якому працює сервер (наприклад, 5000)
EXPOSE 5000

# Команда для запуску сервера
CMD ["npm", "run", "dev"]